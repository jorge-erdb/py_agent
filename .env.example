# Copy this file to .env and adjust as needed.
# All values below are the built-in defaults — every one is optional.

# --- LLM backend (any OpenAI-compatible server) ---
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=sk-no-key-needed
LLM_MODEL=local-model
# Request timeout in seconds
LLM_TIMEOUT=600

# --- Agent identity ---
AGENT_NAME=Kairo
# AGENT_PERSONA=You are an advanced AI assistant designed to be genuinely helpful and rigorously honest.

# --- Server ---
# 0.0.0.0 binds to all interfaces. Use 127.0.0.1 to restrict to this machine.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
